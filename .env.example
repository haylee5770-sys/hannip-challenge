# ─── 데이터베이스 ────────────────────────────────────────────────────────────────
# TiDB Cloud 또는 다른 MySQL 연결 문자열
DATABASE_URL=mysql://user:password@host:4000/dbname?ssl={"rejectUnauthorized":true}

# ─── Supabase ────────────────────────────────────────────────────────────────────
# Supabase 프로젝트 설정 > API 에서 확인
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role 키 (비공개 - 서버 전용)
SUPABASE_BUCKET=uploads           # Storage 버킷 이름

# Supabase 클라이언트용 (공개 키 - 프론트엔드용)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...     # anon 키 (공개)

# ─── OpenAI ──────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ─── 앱 설정 ─────────────────────────────────────────────────────────────────────
# 관리자 이메일 (이 이메일로 가입하면 자동으로 admin + approved)
OWNER_EMAIL=your@email.com

# JWT 시크릿 (임의 랜덤 문자열, 32자 이상)
JWT_SECRET=랜덤하고_긴_문자열을_여기에

# ─── Railway 배포 시 자동 설정됨 ──────────────────────────────────────────────────
# PORT=3000
# NODE_ENV=production
